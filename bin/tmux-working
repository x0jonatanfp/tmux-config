#!/usr/bin/env bash
# Punto ● rosa para una ventana de la barra de tmux cuyo agente está trabajando.
# Uso: tmux-working <pane_id>. Mira las últimas líneas del panel y busca lo que cada agente
# muestra solo mientras trabaja (probado con cada uno en marcha y parado):
#   Claude Code  «esc to interrupt» en la línea de estado
#   opencode     «esc interrupt» junto a su indicador animado
#   pi           «Working» entre rayas, con su spinner
#   freebuff     «working...» y el campo «Add to the current task»
# Cuentas atrás y relojes de un agente parado no cuentan. Un agente nuevo se añade aquí.
set -u
pane=${1:-}
[[ $pane =~ ^%[0-9]+$ ]] || exit 0
if tmux capture-pane -p -t "$pane" 2>/dev/null | grep -av '^[[:space:]]*$' | tail -12 \
  | grep -aqE 'esc (to )?interrupt|[[:space:]]Working[[:space:]]+─|^[[:space:]]*working\.\.\.|Add to the current task'; then
  printf '#[fg=#e879f9] ●'
fi
